<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground">

    <!-- Same Logo as before -->
    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="60dp"
        android:layout_height="45dp"
        android:scaleType="fitCenter"
        android:layout_marginEnd="12dp"
        android:src="@android:drawable/ic_menu_gallery"/>

    <!-- NAYA BLOCK: EPG Layout jo Center mein aayega -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginEnd="12dp"
        android:gravity="center_vertical">

        <!-- Purana Channel Name (Thoda chota kiya taaki Program name highlight ho) -->
        <TextView
            android:id="@+id/tvChannelName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#CCCCCC"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end"/>

        <!-- Program Title aur Time ka Horizontal Layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp"
            android:gravity="bottom">

            <TextView
                android:id="@+id/tvProgramTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="No EPG teleguide"/>

            <TextView
                android:id="@+id/tvProgramTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:layout_marginStart="8dp"
                android:text=""/>
        </LinearLayout>

        <!-- EPG Progress Bar (Sky Blue theme) -->
        <ProgressBar
            android:id="@+id/pbEpgProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="6dp"
            android:progress="0"
            android:max="100"
            android:progressTint="#00BCD4"
            android:progressBackgroundTint="#444444"/>

    </LinearLayout>

    <!-- Same Fav button as before -->
    <ImageView
        android:id="@+id/imgFav"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:src="@android:drawable/star_off"/>

</LinearLayout>
